{
  "name": "life-in-alexmotion",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот канала Life in AlexMotion: inbox материалов, AI-черновики, публикация. Cloudflare Worker + D1.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node scripts/gen-voice-examples.mjs --check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply alexmotion --local",
    "db:migrate:remote": "wrangler d1 migrations apply alexmotion --remote",
    "gen:voice": "node scripts/gen-voice-examples.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "vitest": "~2.1.8",
    "wrangler": "^3.91.0"
  }
}
